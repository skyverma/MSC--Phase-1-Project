W_opt)\n","y_pred_custom_test=predict(x_test_custom_scaled, W_opt)\n","# Calculate MAPE for the custom implementation\n","mape_custom = mape_fn(y_train, y_pred_custom)\n","\n","# Print MAPE for custom Ridge Regression\n","print(f'MAPE (Custom Ridge Regression - SLSQP): {mape_custom:.2f}%')\n","\n","\n","\n","\n","# Standardizing the features for sklearn model\n","x_train_scaled = scaler.fit_transform(x_train)\n","x_test_scaled = scaler.transform(x_test)\n","\n","\n","\n","# Initialize Ridge regression model from sklearn\n","model_sklearn = Ridge(alpha=l2_penalty, fit_intercept=True)\n","\n","# Fit the model to the training data\n","model_sklearn.fit(x_train_scaled, y_train)\n","\n","# Predict using sklearn model\n","y_pred_sklearn = model_sklearn.predict(x_train_scaled)\n","y_pred_test_sklearn=model_sklearn.predict(x_test_scaled)\n","# Calculate MAPE for sklearn implementation\n","mape_sklearn = mape_fn(y_train, y_pred_sklearn)\n","\n","# Print MAPE for Ridge Regression with sklearn\n","print(f'MAPE (Ridge Regression - sklearn): {mape_sklearn:.2f}%')\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"tIWbsglQDFAv","executionInfo":{"status":"ok","timestamp":1728895798564,"user_tz":-330,"elapsed":16,"user":{"displayName":"Aakash Verma","userId":"06413685511527983680"}},"outputId":"e7ef2c9f-825f-4ba0-dd7c-ebd21b6c1f38"},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["MAPE (Custom Ridge Regression - SLSQP): 17939.30%\n","MAPE (Ridge Regression - sklearn): 14133.97%\n"]}]},{"cell_type":"code","source":["Custom_ridge(df_encoded)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kNMAZlk9CaBL","executionInfo":{"status":"ok","timestamp":1728895798564,"user_tz":-330,"elapsed":13,"user":{"displayName":"Aakash Verma","userId":"06413685511527983680"}},"outputId":"fee36cb1-719d-491f-e20e-2f5e9f80e541"},"execution_count":27,"outputs":[{"output_type":"execute_result","data":{"text/plain":["(17939.300180962276,