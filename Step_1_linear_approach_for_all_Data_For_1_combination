ndom_state=42)\n","\n","# Create polynomial features up to degree 3\n","poly = PolynomialFeatures(degree=3)\n","\n","# Transform the training and test sets\n","x_train_poly = poly.fit_transform(x_train)\n","x_test_poly = poly.transform(x_test)\n","\n","# Add intercept for custom implementation\n","x_train_custom_poly = np.c_[np.ones((x_train_poly.shape[0], 1)), x_train_poly]\n","x_test_custom_poly = np.c_[np.ones((x_test_poly.shape[0], 1)), x_test_poly]\n","\n","# Standardize the polynomial features\n","scaler = StandardScaler()\n","x_train_custom_scaled_poly = scaler.fit_transform(x_train_custom_poly)\n","x_test_custom_scaled_poly = scaler.transform(x_test_custom_poly)\n","\n","# Prediction function (including intercept)\n","def predict(X, W):\n","    return X.dot(W[1:]) + W[0]\n","\n","# Define the cost function (including L2 regularization)\n","def cost_function(params, X, Y, l2_penalty):\n","    W = params\n","    Y_pred = predict(X, W)\n","    cost = np.sum((Y - Y_pred) ** 2) / X.shape[0] + l2_penalty * np.sum(W[1:] ** 2)\n","    return cost\n","\n","# MAPE calculation function\n","def mape_fn(y_true, y_pred):\n","    y_true = np.where(y_true == 0, np.finfo(float).eps, y_true)\n","    return np.mean(np.abs((y_true - y_pred) / y_true)) * 100\n","\n","# Set regularization parameter (lambda for Ridge)\n","l2_penalty = 1\n","\n","# Initial parameters (weights + intercept for polynomial features)\n","initial_params = np.zeros(x_train_custom_scaled_poly.shape[1] + 1)\n","\n","# Minimize the cost function using SLSQP\n","result = minimize(\n","    cost_function,\n","    initial_params,\n","    args=(x_train_custom_scaled_poly, y_train, l2_penalty),\n","    method='SLSQP'\n",")\n","\n","# Extract optimized parameters\n","W_opt = result.x\n","\n","# Make predictions on the polynomial training set\n","y_pred_custom_poly = predict(x_train_custom_scaled_poly, W_opt)\n","y_pred_custom_test_poly = predict(x_test_custom_scaled_poly, W_opt)\n","\n","# Calculate MAPE for the custom polynomial implementation\n","mape_custom_poly = mape_fn(y_train, y_pred_custom_poly)\n","\n","# Print MAPE for custom Ridge Regression with polynomial features\n","print(f'MAPE (Custom Ridge Regression - SLSQP, degree 3): {mape_custom_poly:.2f}%')\n","\n","# Standardizing the polynomial features for sklearn model\n","x_train_scaled_poly = scaler.fit_transform(x_train_poly)\n","x_test_scaled_poly = scaler.transform(x_test_poly)\n","\n","# Initialize Ridge regression model from sklearn\n","model_sklearn_poly = Ridge(alpha=l2_penalty, fit_intercept=True)\n","\n","# Fit the model to the polynomial training data\n","model_sklearn_poly.fit(x_train_scaled_poly, y_train)\n","\n","# Predict using sklearn model on polynomial features\n","y_pred_sklearn_poly = model_sklearn_poly.predict(x_train_scaled_poly)\n","y_pred_test_sklearn_poly = model_sklearn_poly.predict(x_test_scaled_poly)\n","\n","# Calculate MAPE for sklearn implementation with polynomial features\n","mape_sklearn_poly = mape_fn(y_train, y_pred_sklearn_poly)\n","\n","# Print MAPE for Ridge Regression with sklearn and polynomial features\n","print(f'MAPE (Ridge Regression - sklearn, degree 3): {mape_sklearn_poly:.2f}%')\n","\n","# Optional: Compare test set predictions\n","mape_custom_test_poly = mape_fn(y_test, y_pred_custom_test_poly)\n","mape_sklearn_test_poly = mape_fn(y_test, y_pred_test_sklearn_poly)\n","\n","print(f'MAPE on test set (Custom Ridge Regression - degree 3): {mape_custom_test_poly:.2f}%')\n","print(f'MAPE on test set (Ridge Regression - sklearn, degree 3): {mape_sklearn_test_poly:.2f}%')\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"w1rt1JRzEvb4","executionInfo":{"status":"ok","timestamp":1728895946924,"user_tz":-330,"elapsed":143062,"user":{"displayName":"Aakash Verma","userId":"06413685511527983680"}},"outputId":"6f22cbad-569e-4f08-df3c-afa3c065d88c"},"execution_count":35,"outputs":[{"output_type":"stream","name":"stdout","text":["MAPE (Custom Ridge Regression - SLS